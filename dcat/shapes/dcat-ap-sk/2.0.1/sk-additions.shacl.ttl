# DCAT-AP-SK 2.0.1: what the Slovak profile makes mandatory beyond DCAT-AP 2.1.1, as SHACL.
#
# Written in this repository (T-4510): the profile publishes no SHACL of its own
# (github.com/datova-kancelaria/dcat-ap-sk-2.0 at ef77138 holds the spec, a JSON-LD context,
# JSON schemas and examples, no shapes). Each shape names the section of the spec it encodes in
# rdfs:seeAlso; a rule without a section does not belong here. Used together with the SEMIC
# DCAT-AP 2.1.1 shapes beside it (../../dcat-ap/2.1.1/), which hold everything the base requires.

@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix leg: <https://data.gov.sk/def/ontology/legislation/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sk: <https://datova-kancelaria.github.io/dcat-ap-sk-2.0/#> .
@prefix jcsk: <https://joinedcontext.com/conformance/dcat-ap-sk/2.0.1#> .

jcsk:Catalog a sh:NodeShape ;
    sh:targetClass dcat:Catalog ;
    sh:property [ sh:path dct:title ; sh:minCount 1 ; rdfs:seeAlso sk:katalóg-názov ] ,
                [ sh:path dct:description ; sh:minCount 1 ; rdfs:seeAlso sk:katalóg-popis ] ,
                [ sh:path dct:publisher ; sh:minCount 1 ; sh:nodeKind sh:IRI ; rdfs:seeAlso sk:katalóg-poskytovateľ ] ,
                [ sh:path dcat:dataset ; sh:minCount 1 ; rdfs:seeAlso sk:katalóg-dataset ] .

jcsk:Dataset a sh:NodeShape ;
    sh:targetClass dcat:Dataset ;
    sh:property [ sh:path dct:publisher ; sh:minCount 1 ; sh:nodeKind sh:IRI ; rdfs:seeAlso sk:dataset-poskytovateľ ] ,
                [ sh:path dcat:theme ; sh:minCount 1 ; rdfs:seeAlso sk:dataset-téma ] ,
                [ sh:path dct:accrualPeriodicity ; sh:minCount 1 ; sh:maxCount 1 ; rdfs:seeAlso sk:dataset-periodicita-aktualizácie ] ,
                [ sh:path dcat:keyword ; sh:minCount 1 ; rdfs:seeAlso sk:dataset-kľúčové-slová ] ,
                # mandatory unless the dataset is the umbrella of a series, which no Endpoint record is
                [ sh:path dcat:distribution ; sh:minCount 1 ; rdfs:seeAlso sk:dataset-distribúcia ] .

jcsk:Distribution a sh:NodeShape ;
    sh:targetClass dcat:Distribution ;
    sh:property [ sh:path dcat:accessURL ; sh:minCount 1 ; rdfs:seeAlso sk:distribúcia-prístupové-url ] ,
                [ sh:path leg:termsOfUse ; sh:minCount 1 ; sh:maxCount 1 ; sh:class leg:TermsOfUse ;
                  rdfs:seeAlso sk:špecifikácia-podmienok-použitia ] .

jcsk:TermsOfUse a sh:NodeShape ;
    sh:targetClass leg:TermsOfUse ;
    sh:property [ sh:path leg:authorsWorkType ; sh:minCount 1 ; rdfs:seeAlso sk:špecifikácia-podmienok-použitia ] ,
                [ sh:path leg:originalDatabaseType ; sh:minCount 1 ; rdfs:seeAlso sk:špecifikácia-podmienok-použitia ] ,
                [ sh:path leg:databaseProtectedBySpecialRightsType ; sh:minCount 1 ; rdfs:seeAlso sk:špecifikácia-podmienok-použitia ] ,
                [ sh:path leg:personalDataContainmentType ; sh:minCount 1 ; rdfs:seeAlso sk:špecifikácia-podmienok-použitia ] .
