# DCAT-AP-CZ 2026-09-23: the cardinalities the spec tables set, as SHACL.
#
# Written in this repository (T-4510) from the "Hlavní profily tříd" tables of
# https://ofn.gov.cz/dcat-ap-cz-otevřená-data/2026-09-23/cs/: the published shacl.ttl beside it
# checks ranges and datatypes but no sh:minCount, so a record missing a mandatory item passes it.
# One property shape per row of cardinality [1..1] or [1..*] on the classes every Endpoint record
# has (the dataset, its distributions, their data service, the terms-of-use specification); the
# file-download and data-service variants of a distribution are left to the profile text, since
# a record says which one it is only by what it carries. rdfs:seeAlso is the row's own IRI.

@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix r5r: <http://data.europa.eu/r5r/> .
@prefix pu: <https://data.gov.cz/slovník/podmínky-užití/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix jccz: <https://joinedcontext.com/conformance/dcat-ap-cz/2026-09-23#> .

jccz:Dataset a sh:NodeShape ;
    sh:targetClass dcat:Dataset ;
    sh:property [ sh:path dct:title ; sh:minCount 1 ; sh:maxCount 1 ; rdfs:seeAlso <https://ofn.gov.cz/dcat-ap-cz-otevřená-data#DatováSada.název> ] ,
                [ sh:path dct:description ; sh:minCount 1 ; sh:maxCount 1 ; rdfs:seeAlso <https://ofn.gov.cz/dcat-ap-cz-otevřená-data#DatováSada.popis> ] ,
                [ sh:path dcat:keyword ; sh:minCount 1 ; rdfs:seeAlso <https://ofn.gov.cz/dcat-ap-cz-otevřená-data#DatováSada.klíčovéSlovo> ] ,
                [ sh:path dcat:theme ; sh:minCount 1 ; rdfs:seeAlso <https://ofn.gov.cz/dcat-ap-cz-otevřená-data#DatováSada.téma> ] ,
                [ sh:path dct:accrualPeriodicity ; sh:minCount 1 ; sh:maxCount 1 ; rdfs:seeAlso <https://ofn.gov.cz/dcat-ap-cz-otevřená-data#DatováSada.periodicitaAktualizace> ] ,
                [ sh:path dct:publisher ; sh:minCount 1 ; sh:maxCount 1 ; rdfs:seeAlso <https://ofn.gov.cz/dcat-ap-cz-otevřená-data#DatováSada.poskytovatel> ] ,
                [ sh:path dct:spatial ; sh:minCount 1 ; rdfs:seeAlso <https://ofn.gov.cz/dcat-ap-cz-otevřená-data#DatováSada.souvisejícíGeografickéÚzemí-PrvekZRúian> ] ,
                [ sh:path r5r:applicableLegislation ; sh:minCount 1 ; rdfs:seeAlso <https://ofn.gov.cz/dcat-ap-cz-otevřená-data#DatováSada.příslušnýPrávníPředpis> ] .

jccz:Distribution a sh:NodeShape ;
    sh:targetClass dcat:Distribution ;
    sh:property [ sh:path dcat:accessURL ; sh:minCount 1 ; sh:maxCount 1 ; rdfs:seeAlso <https://ofn.gov.cz/dcat-ap-cz-otevřená-data#Distribuce.přístupovéUrl> ] ,
                [ sh:path pu:specifikace ; sh:minCount 1 ; sh:maxCount 1 ; rdfs:seeAlso <https://ofn.gov.cz/dcat-ap-cz-otevřená-data#Distribuce.specifikacePodmínekUžití> ] ,
                [ sh:path r5r:applicableLegislation ; sh:minCount 1 ; rdfs:seeAlso <https://ofn.gov.cz/dcat-ap-cz-otevřená-data#Distribuce.příslušnýPrávníPředpis> ] .

jccz:DataService a sh:NodeShape ;
    sh:targetClass dcat:DataService ;
    sh:property [ sh:path dcat:endpointURL ; sh:minCount 1 ; sh:maxCount 1 ; rdfs:seeAlso <https://ofn.gov.cz/dcat-ap-cz-otevřená-data#DatováSlužba.přístupovýBodSlužby> ] ,
                [ sh:path dcat:endpointDescription ; sh:minCount 1 ; sh:maxCount 1 ; rdfs:seeAlso <https://ofn.gov.cz/dcat-ap-cz-otevřená-data#DatováSlužba.popisPřístupovéhoBoduSlužby> ] ,
                [ sh:path r5r:applicableLegislation ; sh:minCount 1 ; rdfs:seeAlso <https://ofn.gov.cz/dcat-ap-cz-otevřená-data#DatováSlužba.příslušnýPrávníPředpis> ] ,
                [ sh:path dct:title ; sh:minCount 1 ; sh:maxCount 1 ; rdfs:seeAlso <https://ofn.gov.cz/dcat-ap-cz-otevřená-data#DatováSlužba.název> ] .

jccz:Specifikace a sh:NodeShape ;
    sh:targetClass pu:Specifikace ;
    sh:property [ sh:path pu:autorské-dílo ; sh:minCount 1 ; sh:maxCount 1 ; rdfs:seeAlso <https://ofn.gov.cz/dcat-ap-cz-otevřená-data#SpecifikacePodmínekUžití.autorskéDílo> ] ,
                [ sh:path pu:databáze-jako-autorské-dílo ; sh:minCount 1 ; sh:maxCount 1 ; rdfs:seeAlso <https://ofn.gov.cz/dcat-ap-cz-otevřená-data#SpecifikacePodmínekUžití.originálníDatabáze> ] ,
                [ sh:path pu:databáze-chráněná-zvláštními-právy ; sh:minCount 1 ; sh:maxCount 1 ; rdfs:seeAlso <https://ofn.gov.cz/dcat-ap-cz-otevřená-data#SpecifikacePodmínekUžití.zvláštníPrávoPořizovateleDatabáze> ] ,
                [ sh:path pu:osobní-údaje ; sh:minCount 1 ; sh:maxCount 1 ; rdfs:seeAlso <https://ofn.gov.cz/dcat-ap-cz-otevřená-data#SpecifikacePodmínekUžití.osobníÚdaje> ] .
