@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix ngsi-ld: <https://uri.etsi.org/ngsi-ld/> .
@prefix bb: <https://bb.example.sk/ns/air-quality#> .

bb:AirQualityObservedShape
    a sh:NodeShape ;
    sh:targetClass bb:AirQualityObserved ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [
        sh:path bb:stationName ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path ngsi-ld:hasValue ;
                sh:minCount 1 ;
                sh:datatype xsd:string ;
            ] ;
        ] ;
    ] ;
    sh:property [
        sh:path bb:pm10 ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path ngsi-ld:hasValue ;
                sh:minCount 1 ;
                sh:datatype xsd:double ;
            ] ;
        ] ;
    ] ;
    sh:property [
        sh:path bb:pm25 ;
        sh:node [
            sh:property [
                sh:path ngsi-ld:hasValue ;
                sh:datatype xsd:double ;
            ] ;
        ] ;
    ] ;
    sh:property [
        sh:path bb:temperature ;
        sh:node [
            sh:property [
                sh:path ngsi-ld:hasValue ;
                sh:datatype xsd:double ;
            ] ;
        ] ;
    ] ;
    sh:property [
        sh:path bb:dateObserved ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path ngsi-ld:hasValue ;
                sh:minCount 1 ;
                sh:datatype xsd:string ;
            ] ;
        ] ;
    ] .
