{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "The open-data question set of data.dev's assistant (T-4359)",
  "type": "object",
  "required": [
    "about",
    "canary",
    "known",
    "questions"
  ],
  "additionalProperties": false,
  "properties": {
    "about": {
      "type": "string"
    },
    "canary": {
      "type": "string",
      "pattern": "^KANARIK-"
    },
    "questions": {
      "type": "array",
      "minItems": 20,
      "items": {
        "type": "object",
        "required": [
          "id",
          "lang",
          "kind",
          "q",
          "must"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^o[du]-[0-9]{2}$"
          },
          "lang": {
            "enum": [
              "cs",
              "en",
              "sk"
            ]
          },
          "kind": {
            "enum": [
              "catalogue",
              "count",
              "value",
              "location",
              "temporal",
              "absent",
              "injection",
              "scope",
              "unknowable",
              "direct",
              "area"
            ]
          },
          "q": {
            "type": "string",
            "minLength": 10
          },
          "must": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          },
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "role",
                "text"
              ]
            }
          },
          "truth": {
            "type": "object",
            "required": [
              "expect"
            ],
            "minProperties": 2,
            "maxProperties": 2,
            "properties": {
              "expect": {
                "enum": [
                  "titles",
                  "text",
                  "number",
                  "name",
                  "none",
                  "scope",
                  "date",
                  "all",
                  "shape"
                ]
              },
              "ckan": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "q": {
                    "type": "string"
                  },
                  "fq": {
                    "type": "string"
                  }
                }
              },
              "ckanShow": {
                "type": "object",
                "required": [
                  "id",
                  "fields"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "fields": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "count": {
                "$ref": "#/definitions/read"
              },
              "attr": {
                "allOf": [
                  {
                    "$ref": "#/definitions/read"
                  },
                  {
                    "required": [
                      "attr"
                    ]
                  }
                ]
              },
              "nearest": {
                "allOf": [
                  {
                    "$ref": "#/definitions/read"
                  },
                  {
                    "required": [
                      "type",
                      "point"
                    ]
                  }
                ]
              },
              "temporalMax": {
                "allOf": [
                  {
                    "$ref": "#/definitions/read"
                  },
                  {
                    "required": [
                      "id",
                      "attr",
                      "hours"
                    ]
                  }
                ]
              },
              "list": {
                "allOf": [
                  {
                    "$ref": "#/definitions/read"
                  },
                  {
                    "required": [
                      "type"
                    ]
                  }
                ]
              },
              "latest": {
                "allOf": [
                  {
                    "$ref": "#/definitions/read"
                  },
                  {
                    "required": [
                      "type",
                      "sort",
                      "attr"
                    ]
                  }
                ]
              },
              "page": {
                "type": "object",
                "required": [
                  "url",
                  "says"
                ],
                "additionalProperties": false,
                "properties": {
                  "url": {
                    "type": "string",
                    "pattern": "^https://"
                  },
                  "says": {
                    "type": "string",
                    "minLength": 3
                  }
                }
              },
              "formats": {
                "type": "object",
                "required": [
                  "dataset"
                ],
                "additionalProperties": false,
                "properties": {
                  "dataset": {
                    "type": "string"
                  }
                }
              },
              "datastore": {
                "type": "object",
                "required": [
                  "resource"
                ],
                "additionalProperties": false,
                "properties": {
                  "resource": {
                    "type": "string",
                    "pattern": "^[0-9a-f-]{36}$"
                  },
                  "latestDate": {
                    "type": "string"
                  },
                  "sumLatestYear": {
                    "type": "object",
                    "required": [
                      "year",
                      "amount"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "year": {
                        "type": "string"
                      },
                      "amount": {
                        "type": "string"
                      }
                    }
                  }
                },
                "oneOf": [
                  {
                    "required": [
                      "latestDate"
                    ]
                  },
                  {
                    "required": [
                      "sumLatestYear"
                    ]
                  }
                ]
              },
              "shape": {
                "allOf": [
                  {
                    "$ref": "#/definitions/read"
                  },
                  {
                    "required": [
                      "type",
                      "name"
                    ]
                  }
                ]
              },
              "touches": {
                "allOf": [
                  {
                    "$ref": "#/definitions/read"
                  },
                  {
                    "required": [
                      "type",
                      "name"
                    ]
                  }
                ]
              }
            },
            "additionalProperties": false
          },
          "persona": {
            "type": "string"
          },
          "why": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "minLength": 10
          },
          "observed": {
            "type": "object",
            "required": [
              "observedAt"
            ],
            "properties": {
              "value": {},
              "observedAt": {
                "type": "string"
              },
              "unavailable": {
                "type": "string"
              },
              "of": {
                "type": "object"
              },
              "year": {
                "type": "integer"
              },
              "rows": {
                "type": "integer"
              },
              "empty": {
                "type": "integer"
              }
            },
            "additionalProperties": false
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "enum": [
                    "injection",
                    "unknowable",
                    "direct"
                  ]
                }
              }
            },
            "then": {},
            "else": {
              "required": [
                "truth"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "id": {
                  "pattern": "^od-(3[3-9]|[45][0-9])$"
                }
              }
            },
            "then": {
              "required": [
                "source",
                "persona",
                "why"
              ]
            }
          }
        ]
      }
    },
    "known": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "definitions": {
    "read": {
      "type": "object",
      "required": [
        "slug"
      ],
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]{20,40}$"
        },
        "type": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "pattern": "^urn:ngsi-ld:"
        },
        "q": {
          "type": "string"
        },
        "attr": {
          "type": "string"
        },
        "point": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "hours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 168
        },
        "match": {
          "type": "string"
        },
        "sort": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "via": {
          "type": "string"
        },
        "within": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50000
        },
        "latestYear": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "anyOf": [
        {
          "required": [
            "type"
          ]
        },
        {
          "required": [
            "id"
          ]
        }
      ]
    }
  }
}
